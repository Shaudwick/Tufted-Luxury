# Copy this file to `.env` and fill in values. Never commit `.env`.
# Gmail: use an App Password, not your normal login password.

SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=

# Stripe (needed for server endpoints: deposits, Checkout session, hourly rentals, webhooks).
# Shop merch + Gods use Payment Links — see docs/PAYMENT_LINKS_SETUP.md — no Stripe key needed for those.
# Hourly art rental uses Checkout Sessions via POST /api/rental-checkout (requires STRIPE_SECRET_KEY).
# On Vercel: Project Settings → Environment Variables → add STRIPE_SECRET_KEY (and webhook secret), then Redeploy.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: recipient for `node test-email.js` (defaults to SMTP_USER if unset)
TEST_EMAIL_RECIPIENT=

PORT=4242
NODE_ENV=development
